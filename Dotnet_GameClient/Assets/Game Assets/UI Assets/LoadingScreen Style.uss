.loading-root {
    flex-grow: 1;
    background-color: var(--col-bg);
    align-items: center;
    justify-content: space-between;
    padding-top: 60px;
    padding-right: 60px;
    padding-bottom: 60px;
    padding-left: 60px;
}

.loading__center {
    align-items: center;
    justify-content: center;
    flex-grow: 1;
}

.center__game-title {
    font-size: 110px;
    color: var(--col-accent);
    -unity-text-align: upper-center;
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgb(231, 231, 231);
    letter-spacing: 8px;
}

.center__game-subtitle {
    font-size: 26px;
    color: var(--col-text-dim);
    margin-top: 18px;
    letter-spacing: 4px;
    -unity-text-align: upper-center;
}

.loading__bottom {
    width: 100%;
    align-items: center;
    justify-content: center;
    margin-bottom: 15px;
}

.bottom__status {
    font-size: 22px;
    color: var(--col-text);
    margin-bottom: 14px;
}

.progress-track {
    width: 100%;
    height: 30px;
    background-color: var(--col-track);
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    border-top-color: var(--col-border-light);
    border-right-color: var(--col-border-light);
    border-bottom-color: var(--col-border-light);
    border-left-color: var(--col-border-light);
    padding-top: 3px;
    padding-right: 3px;
    padding-bottom: 3px;
    padding-left: 3px;
}

.progress-fill {
    height: 100%;
    background-color: var(--col-success);
    width: 0;
}

.version-label {
    position: absolute;
    right: 20px;
    bottom: 14px;
    font-size: 18px;
    color: var(--col-text-dim);
}
